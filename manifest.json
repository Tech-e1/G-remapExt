{
  "manifest_version": 3,
  "name": "Google Maps → Brave Maps",
  "version": "1.1",
  "description": "Redirects Google Maps URLs to Brave Maps equivalents",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*",
    "https://goo.gl/*",
    "https://maps.app.goo.gl/*",
    "https://www.google.com/maps/app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://www.google.com/maps/app/*"
      ],
      "js": ["redirect.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
